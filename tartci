#!/usr/bin/env bash
# tartci — front door for local CI VMs on macOS (Tart + QEMU + Shipyard).
#
# This dispatcher wires the parts of the toolkit that are proven today and is
# honest about what is still hand-driven (see docs/runbook.md). It adds NO
# dependencies of its own — just bash + the tools `doctor` checks for.
#
#   tartci doctor              # report host prereqs + stores + shipyard github-auth (always safe)
#   tartci doctor --reap --json [--fix]  # report/fix safe owned CI residue
#   tartci doctor fleet [--json]  # diagnose fleet config: executed generation,
#                              # deploy/drain capability, dual-scope runner census
#   tartci reclaim [--fix] [--json]      # reclaim idle regenerable build dirs
#   tartci status --json       # report host-local provider/profile state
#   tartci host-profile [--json] # emit derived role/budget settings
#   tartci host-profile --delivery [--json] # how code reaches each lane + staleness
#   tartci network-profile [status|reconcile|rollback] # opt-in host relay convergence
#   tartci leases [status|acquire|release|heartbeat|reap] # inspect the host lease store
#   tartci profile <cmd>       # list/show/explain/plan routing profiles
#   tartci fleet-macos <validate|render|install> CONFIG # manage dormant generic VM lanes
#   tartci support-manifest <write|verify|stage-install> # bind/install runtime cohort
#   tartci gate-slot2 <render|validate|install> # managed second Pulp macOS gate lane
#   tartci tart-image-sync ... # resumable, checksum-verified Tart golden transfer
#   tartci observe macos       # read-only live view of macOS VM runners/jobs
#   tartci setup               # brew-install prereqs + create local stores
#   tartci bench <os> [name]   # clone a golden → open in UTM for GUI/DAW testing
#   tartci metrics [report|dashboard] [file]
#   tartci timings [log-root|timing.tsv ...]
#   tartci runtime <summary|export|recent|backfill|prune|complete>
#   tartci windows run         # boot the Windows QEMU VM (provider script)
#   tartci pool <on|drain|off|status> # durable host admission and participation
#                              # --plan: print the transition, write nothing;
#                              # off refuses a mid-job lane (exit 12) unless --now
#   tartci windows optimize    # prewarm/validate a booted Windows golden VM
#   tartci windows golden [nm] # clean-shutdown + compress-tag a Windows golden
#   tartci goldens list        # canonical golden + drift/prune candidates
#   tartci goldens sync --to HOST [--os windows] [--prune] [--dry-run]  # copy canonical golden to a host (fastest link) + verify + repoint
#   tartci prepare <os>        # bake/provision a golden from the provider recipe
#   tartci up <os>             # one on-demand build+ctest in a throwaway clone, then discard
#   tartci serve <os> [--loop] # serve the GitHub Actions pool: ephemeral per-job runner(s)
#   tartci launchd <reload <label>|status|heal>  # heal a wedged serve LaunchAgent (full bootout+bootstrap)
#                              # reload refuses a mid-job lane (exit 3) unless --allow-mid-job;
#                              # --dry-run prints the plan or REFUSE (exit 0 / 3)
#   tartci launchd guard --hook  # PreToolUse classifier: block raw launchctl on lanes
#   tartci hooks print         # print (never write) Claude/Codex hook settings
#   tartci help
#
# Stores (override via env): TARTCI_HOME (default ~/.tartci) holds goldens/,
# bench/, windows/, iso/. Large images live here and are NEVER committed.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARTCI_HOME="${TARTCI_HOME:-$HOME/.tartci}"
export TARTCI_GOLDENS="${TARTCI_GOLDENS:-$TARTCI_HOME/goldens}"
export TARTCI_BENCH="${TARTCI_BENCH:-$TARTCI_HOME/bench}"
export TARTCI_WIN="${TARTCI_WIN:-$TARTCI_HOME/windows}"

c_ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
c_miss() { printf '  \033[31m✗\033[0m %s\n' "$1"; }
c_warn() { printf '  \033[33m•\033[0m %s\n' "$1"; }

# macOS still ships Python 3.9, but fleet profile/readiness helpers use the
# stdlib tomllib module added in Python 3.11. Resolve a supported interpreter
# explicitly so launchd cannot turn a real readiness result into the generic
# readiness_probe_failed fallback. TARTCI_PYTHON may name an absolute path or
# a PATH command; otherwise prefer common Homebrew 3.11/3.12 installations.
tartci_toml_python_path() {
  local candidate configured="${TARTCI_PYTHON:-}"
  if [ -n "$configured" ]; then
    candidate="$(command -v "$configured" 2>/dev/null || true)"
    [ -n "$candidate" ] && "$candidate" -c 'import tomllib' >/dev/null 2>&1 || {
      echo "tartci: TARTCI_PYTHON must name a Python 3.11+ interpreter with tomllib: $configured" >&2
      return 127
    }
    printf '%s\n' "$candidate"
    return 0
  fi

  for candidate in python3.12 python3.11; do
    candidate="$(command -v "$candidate" 2>/dev/null || true)"
    if [ -n "$candidate" ] && "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  candidate="$(command -v python3 2>/dev/null || true)"
  if [ -n "$candidate" ] && "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
    printf '%s\n' "$candidate"
    return 0
  fi

  for candidate in \
    /opt/homebrew/bin/python3.12 /opt/homebrew/bin/python3.11 \
    /opt/homebrew/bin/python3 \
    /usr/local/bin/python3.12 /usr/local/bin/python3.11 \
    /usr/local/bin/python3; do
    if [ -x "$candidate" ] && "$candidate" -c 'import tomllib' >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  echo "tartci: no Python 3.11+ interpreter with tomllib is available; set TARTCI_PYTHON" >&2
  return 127
}

tartci_toml_python() {
  local python
  python="$(tartci_toml_python_path)" || return 127
  "$python" "$@"
}

# Replace this process with a TOML-reading helper. A bare `python3` under ssh or
# launchd is /usr/bin/python3 (3.9, no tomllib): the helper then cannot read the
# fleet profile and fails with a misleading cause (e.g. "Tart store unavailable").
tartci_toml_exec() {
  local python
  python="$(tartci_toml_python_path)" || return 127
  exec "$python" "$@"
}

# check_shipyard_auth — non-fatal onboarding check (see runbook §1).
# Shipyard's GitHub auth must point at the GitHub-App installation token (the
# `[github.auth]` source="command" helper in its config.toml). A host that never
# imported that config silently falls back to the ambient `gh` token, which for
# an App with no user login is an anonymous 60/hr bucket — Shipyard then shows
# "updates paused" in its menu bar with no error. We surface that here by reading
# `shipyard auth doctor` (the supported diagnostic) and WARN, never fail: hosts
# without Shipyard are legitimate, and doctor must stay green for them.
check_shipyard_auth() {
  echo "shipyard github-auth:"
  if ! command -v shipyard >/dev/null 2>&1; then
    c_warn "shipyard (optional: not installed — skipping github-auth check)"
    return 0
  fi
  local out
  out="$(shipyard auth doctor 2>/dev/null || true)"
  if printf '%s' "$out" | grep -q 'github-app-installation'; then
    c_ok "App-token helper (github-app-installation)"
  elif printf '%s' "$out" | grep -q 'gh-cli (ambient)'; then
    c_warn "DEGRADED — ambient gh token (anonymous 60/hr; menu bar will show 'updates paused')."
    c_warn "  Import the App-token config: shipyard auth import <bundle> --scope global   (runbook §1)"
  else
    c_warn "could not read source from 'shipyard auth doctor' — verify auth manually (runbook §1)"
  fi
}

cmd_doctor() {
  if [ "${1:-}" = "--reap" ]; then
    shift
    exec python3 "$HERE/scripts/vm_reap.py" "$@"
  fi
  # `doctor fleet` is the fleet-wide diagnosis; bare `doctor` stays the host
  # prereq report, which must keep passing on hosts that run no fleet at all.
  if [ "${1:-}" = "fleet" ]; then
    shift
    tartci_toml_exec "$HERE/scripts/fleet_doctor.py" "$@"
  fi
  echo "tartci doctor — host: $(uname -m) $(sw_vers -productName 2>/dev/null) $(sw_vers -productVersion 2>/dev/null)"
  echo "prereqs:"
  for t in tart qemu-system-aarch64 qemu-img sshpass gh git jq; do
    if command -v "$t" >/dev/null 2>&1; then c_ok "$t ($(command -v "$t"))"; else c_miss "$t (missing)"; fi
  done
  # vncdotool + UTM are optional helpers.
  command -v vncdo >/dev/null 2>&1 && c_ok "vncdo (VNC drive)" || c_warn "vncdo (optional: headless VNC drive — pip install vncdotool)"
  [ -d /Applications/UTM.app ] && c_ok "UTM.app (GUI bench)" || c_warn "UTM.app (optional: GUI/DAW bench)"
  # Two janitors, two different failures: the disk reclaimer keeps the lease's
  # disk axis servable, the VM janitor removes stale VMs and overlays. Report
  # both by name — a host can carry either, both or neither, and a missing one
  # is silent until its volume or its VM store fills.
  echo "janitors:"
  # Name only a remedy that exists: the reclaimer has an installer, the VM
  # janitor is still rendered by hand from its template, and a message pointing
  # at a script that is not there costs the reader the trip.
  for _j in "reclaim:disk reclaimer:scripts/install_reclaim_agent.sh --install" \
            "reap:VM janitor:render launchd/com.danielraffel.tartci.reap.plist.template"; do
    _label="com.danielraffel.tartci.${_j%%:*}"
    _rest="${_j#*:}"; _desc="${_rest%%:*}"; _fix="${_rest#*:}"
    if launchctl print "gui/$(id -u)/$_label" >/dev/null 2>&1; then
      c_ok "$_desc ($_label loaded)"
    elif [ -f "${TARTCI_AGENTS_DIR:-$HOME/Library/LaunchAgents}/$_label.plist" ]; then
      c_warn "$_desc ($_label installed but NOT loaded — launchctl bootstrap it)"
    else
      c_warn "$_desc (not installed; $_fix)"
    fi
  done
  unset _j _label _rest _desc _fix
  echo "stores under $TARTCI_HOME:"
  for d in "$TARTCI_GOLDENS" "$TARTCI_BENCH" "$TARTCI_WIN"; do
    [ -d "$d" ] && c_ok "$d" || c_warn "$d (will be created by 'setup')"
  done
  if [ -d "$TARTCI_GOLDENS" ]; then
    local n; n=$(find "$TARTCI_GOLDENS" -maxdepth 1 \( -name '*.qcow2' -o -name '*.tart' \) 2>/dev/null | wc -l | tr -d ' ')
    echo "goldens: $n"; find "$TARTCI_GOLDENS" -maxdepth 1 -name '*.qcow2' 2>/dev/null | sed 's/^/  - /'
  fi
  check_shipyard_auth
  # shellcheck source=providers/common/pool.lib.sh
  . "$HERE/providers/common/pool.lib.sh"
  echo "pool transition lock:"
  tartci_pool_lock_health_json | python3 -c '
import json, sys
value = json.load(sys.stdin)
print("  state: {}".format(value["state"]))
if value["present"]:
    print("  owner pid: {}".format(
        value["owner_pid"] if value["owner_pid"] is not None else "unknown"
    ))
    print("  identity: inode={} mtime_ns={}".format(
        value["inode"], value["mtime_ns"]
    ))
'
}

