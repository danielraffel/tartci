#!/usr/bin/env bash
# tartci — front door for local CI VMs on macOS (Tart + QEMU + Shipyard).
#
# This dispatcher wires the parts of the toolkit that are proven today and is
# honest about what is still hand-driven (see docs/runbook.md). It adds NO
# dependencies of its own — just bash + the tools `doctor` checks for.
#
#   tartci doctor              # report host prereqs + stores + shipyard github-auth (always safe)
#   tartci doctor --reap --json [--fix]  # report/fix safe owned CI residue
#   tartci status --json       # report host-local provider/profile state
#   tartci profile <cmd>       # list/show/explain/plan routing profiles
#   tartci observe macos       # read-only live view of macOS VM runners/jobs
#   tartci setup               # brew-install prereqs + create local stores
#   tartci bench <os> [name]   # clone a golden → open in UTM for GUI/DAW testing
#   tartci metrics [report|dashboard] [file]
#   tartci timings [log-root|timing.tsv ...]
#   tartci runtime <summary|export|recent|backfill|prune|complete>
#   tartci windows run         # boot the Windows QEMU VM (provider script)
#   tartci windows optimize    # prewarm/validate a booted Windows golden VM
#   tartci windows golden [nm] # clean-shutdown + compress-tag a Windows golden
#   tartci goldens list        # canonical golden + drift/prune candidates
#   tartci goldens sync --to HOST [--os windows] [--prune] [--dry-run]  # copy canonical golden to a host (fastest link) + verify + repoint
#   tartci prepare <os>        # bake/provision a golden from the provider recipe
#   tartci up <os>             # one on-demand build+ctest in a throwaway clone, then discard
#   tartci serve <os> [--loop] # serve the GitHub Actions pool: ephemeral per-job runner(s)
#   tartci launchd <reload <label>|status|heal>  # heal a wedged serve LaunchAgent (full bootout+bootstrap)
#   tartci help
#
# Stores (override via env): TARTCI_HOME (default ~/.tartci) holds goldens/,
# bench/, windows/, iso/. Large images live here and are NEVER committed.
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARTCI_HOME="${TARTCI_HOME:-$HOME/.tartci}"
export TARTCI_GOLDENS="${TARTCI_GOLDENS:-$TARTCI_HOME/goldens}"
export TARTCI_BENCH="${TARTCI_BENCH:-$TARTCI_HOME/bench}"
export TARTCI_WIN="${TARTCI_WIN:-$TARTCI_HOME/windows}"

c_ok()   { printf '  \033[32m✓\033[0m %s\n' "$1"; }
c_miss() { printf '  \033[31m✗\033[0m %s\n' "$1"; }
c_warn() { printf '  \033[33m•\033[0m %s\n' "$1"; }

# check_shipyard_auth — non-fatal onboarding check (see runbook §1).
# Shipyard's GitHub auth must point at the GitHub-App installation token (the
# `[github.auth]` source="command" helper in its config.toml). A host that never
# imported that config silently falls back to the ambient `gh` token, which for
# an App with no user login is an anonymous 60/hr bucket — Shipyard then shows
# "updates paused" in its menu bar with no error. We surface that here by reading
# `shipyard auth doctor` (the supported diagnostic) and WARN, never fail: hosts
# without Shipyard are legitimate, and doctor must stay green for them.
check_shipyard_auth() {
  echo "shipyard github-auth:"
  if ! command -v shipyard >/dev/null 2>&1; then
    c_warn "shipyard (optional: not installed — skipping github-auth check)"
    return 0
  fi
  local out
  out="$(shipyard auth doctor 2>/dev/null || true)"
  if printf '%s' "$out" | grep -q 'github-app-installation'; then
    c_ok "App-token helper (github-app-installation)"
  elif printf '%s' "$out" | grep -q 'gh-cli (ambient)'; then
    c_warn "DEGRADED — ambient gh token (anonymous 60/hr; menu bar will show 'updates paused')."
    c_warn "  Import the App-token config: shipyard auth import <bundle> --scope global   (runbook §1)"
  else
    c_warn "could not read source from 'shipyard auth doctor' — verify auth manually (runbook §1)"
  fi
}

cmd_doctor() {
  if [ "${1:-}" = "--reap" ]; then
    shift
    exec python3 "$HERE/scripts/vm_reap.py" "$@"
  fi
  echo "tartci doctor — host: $(uname -m) $(sw_vers -productName 2>/dev/null) $(sw_vers -productVersion 2>/dev/null)"
  echo "prereqs:"
  for t in tart qemu-system-aarch64 qemu-img sshpass gh git jq; do
    if command -v "$t" >/dev/null 2>&1; then c_ok "$t ($(command -v "$t"))"; else c_miss "$t (missing)"; fi
  done
  # vncdotool + UTM are optional helpers.
  command -v vncdo >/dev/null 2>&1 && c_ok "vncdo (VNC drive)" || c_warn "vncdo (optional: headless VNC drive — pip install vncdotool)"
  [ -d /Applications/UTM.app ] && c_ok "UTM.app (GUI bench)" || c_warn "UTM.app (optional: GUI/DAW bench)"
  echo "stores under $TARTCI_HOME:"
  for d in "$TARTCI_GOLDENS" "$TARTCI_BENCH" "$TARTCI_WIN"; do
    [ -d "$d" ] && c_ok "$d" || c_warn "$d (will be created by 'setup')"
  done
  if [ -d "$TARTCI_GOLDENS" ]; then
    local n; n=$(find "$TARTCI_GOLDENS" -maxdepth 1 \( -name '*.qcow2' -o -name '*.tart' \) 2>/dev/null | wc -l | tr -d ' ')
    echo "goldens: $n"; find "$TARTCI_GOLDENS" -maxdepth 1 -name '*.qcow2' 2>/dev/null | sed 's/^/  - /'
  fi
  check_shipyard_auth
}

cmd_status() {
  exec python3 "$HERE/scripts/status.py" "$@"
}

cmd_profile() {
  exec python3 "$HERE/scripts/profile.py" "$@"
}

cmd_observe() {
  local os="${1:-macos}"; shift || true
  case "$os" in
    macos) exec python3 "$HERE/scripts/macos_observe.py" "$@" ;;
    *) echo "usage: tartci observe <macos> [--json] [--runner NAME] [--run-id ID]"; return 2 ;;
  esac
}

cmd_setup() {
  echo "tartci setup — installing prereqs (idempotent) + creating stores"
  if command -v brew >/dev/null 2>&1; then
    brew list cirruslabs/cli/tart >/dev/null 2>&1 || brew install cirruslabs/cli/tart || true
    for f in qemu sshpass jq gh; do brew list "$f" >/dev/null 2>&1 || brew install "$f" || true; done
  else
    echo "Homebrew not found — install it first: https://brew.sh"; return 1
  fi
  mkdir -p "$TARTCI_GOLDENS" "$TARTCI_BENCH" "$TARTCI_WIN" "$TARTCI_HOME/iso"
  echo "stores ready under $TARTCI_HOME"
  cmd_doctor
}

cmd_bench()   { exec "$HERE/bench/bench.sh" "$@"; }

cmd_metrics() {
  local mode="${1:-report}"; shift || true
  local file="${1:-$HERE/metrics/sample.jsonl}"
  case "$mode" in
    report)    exec python3 "$HERE/metrics/report.py" "$file" ;;
    dashboard) exec python3 "$HERE/metrics/dashboard.py" "$file" "${2:-$HERE/metrics/index.html}" ;;
    *) echo "usage: tartci metrics [report|dashboard] [file]"; return 2 ;;
  esac
}

cmd_timings() {
  exec python3 "$HERE/scripts/timing_summary.py" "$@"
}

cmd_runtime() {
  exec python3 "$HERE/scripts/runtime_measure.py" "$@"
}

cmd_windows() {
  local sub="${1:-}"; shift || true
  case "$sub" in
    run)    exec "$HERE/providers/qemu-windows/qemu-run.sh" ;;
    optimize) exec "$HERE/providers/qemu-windows/optimize-golden.sh" "$@" ;;
    golden) exec "$HERE/providers/qemu-windows/make-golden.sh" "$@" ;;
    *)      echo "usage: tartci windows <run|optimize|golden [name]>   (see providers/qemu-windows/)"; return 2 ;;
  esac
}

cmd_goldens() { exec "$HERE/scripts/goldens.sh" "$@"; }

cmd_prepare() {
  local os="${1:-}"; shift || true
  case "$os" in
    linux)   exec "$HERE/providers/tart-linux/provision.sh" "$@" ;;
    windows) echo "tartci prepare windows — use: tartci windows golden [name]"; return 2 ;;
    macos)   exec "$HERE/providers/tart-macos/provision.sh" "$@" ;;
    *) echo "usage: tartci prepare <linux|macos> [provider args]"; return 2 ;;
  esac
}

cmd_up() {
  local os="${1:-}"; shift || true
  case "$os" in
    windows) exec "$HERE/providers/qemu-windows/run.sh" "$@" ;;
    linux)   exec "$HERE/providers/tart-linux/run.sh" "$@" ;;
    macos)   exec "$HERE/providers/tart-macos/run.sh" "$@" ;;
    *) echo "usage: tartci up <linux|macos|windows>"; return 2 ;;
  esac
}

# serve — run an ephemeral, per-job GitHub Actions runner (the pool-serving
# sibling of `up`). `up` does ONE on-demand build and exits; `serve` mints a JIT
# runner config, boots a throwaway clone per queued job, and lets the WORKFLOW
# drive the build. `--loop` keeps serving (what the LaunchAgents run); default is
# one job then exit (pilot-safe). repo/golden/labels are env-driven — see the
# provider runner.sh headers and launchd/ templates.
cmd_serve() {
  local os="${1:-}"; shift || true
  case "$os" in
    linux)   exec "$HERE/providers/tart-linux/runner.sh" "$@" ;;
    windows) exec "$HERE/providers/qemu-windows/runner.sh" "$@" ;;
    macos)   exec "$HERE/providers/tart-macos/runner.sh" "$@" ;;
    *) echo "usage: tartci serve <linux|macos|windows> [--loop] [--labels ...]"; return 2 ;;
  esac
}

cmd_launchd() {
  # launchd caches a job's spec in memory; kickstart/KeepAlive re-run the CACHED
  # spec, so a plist edited/moved without a full reload can wedge a serve agent
  # into an invisible exit-126 crash-loop. `reload` always does the full
  # bootout+bootstrap+kickstart (the only thing that re-reads the plist);
  # `status`/`heal` drive the self-heal watchdog.
  local sub="${1:-status}"; shift || true
  case "$sub" in
    reload) exec python3 "$HERE/scripts/tartci_launchd_watchdog.py" --reload "$@" ;;
    status) exec python3 "$HERE/scripts/tartci_launchd_watchdog.py" --status "$@" ;;
    heal)   exec python3 "$HERE/scripts/tartci_launchd_watchdog.py" "$@" ;;
    *) echo "usage: tartci launchd <reload <label> | status | heal> [--dry-run] [--json]"; return 2 ;;
  esac
}

usage() { sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

case "${1:-help}" in
  doctor)  shift; cmd_doctor "$@" ;;
  status)  shift; cmd_status "$@" ;;
  profile) shift; cmd_profile "$@" ;;
  observe) shift; cmd_observe "$@" ;;
  setup)   cmd_setup ;;
  bench)   shift; cmd_bench "$@" ;;
  metrics) shift; cmd_metrics "$@" ;;
  timings) shift; cmd_timings "$@" ;;
  runtime) shift; cmd_runtime "$@" ;;
  windows) shift; cmd_windows "$@" ;;
  goldens) shift; cmd_goldens "$@" ;;
  prepare) shift; cmd_prepare "$@" ;;
  up)      shift; cmd_up "$@" ;;
  serve)   shift; cmd_serve "$@" ;;
  launchd) shift; cmd_launchd "$@" ;;
  help|-h|--help) usage ;;
  *) echo "unknown command: $1"; echo; usage; exit 2 ;;
esac
