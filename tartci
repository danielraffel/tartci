# serve — run an ephemeral, per-job GitHub Actions runner (the pool-serving
# sibling of `up`). `up` does ONE on-demand build and exits; `serve` mints a JIT
# runner config, boots a throwaway clone per queued job, and lets the WORKFLOW
# drive the build. `--loop` keeps serving (what the LaunchAgents run); default is
# one job then exit (pilot-safe). repo/golden/labels are env-driven — see the
# provider runner.sh headers and launchd/ templates.
cmd_serve() {
  local os="${1:-}"; shift || true
  case "$os" in
    linux)   exec "$HERE/providers/tart-linux/runner.sh" "$@" ;;
    windows) exec "$HERE/providers/qemu-windows/runner.sh" "$@" ;;
    macos)   exec "$HERE/providers/tart-macos/runner.sh" "$@" ;;
    *) echo "usage: tartci serve <linux|macos|windows> [--loop] [--labels ...]"; return 2 ;;
  esac
}

cmd_launchd() {
  # launchd caches a job's spec in memory; kickstart/KeepAlive re-run the CACHED
  # spec, so a plist edited/moved without a full reload can wedge a serve agent
  # into an invisible exit-126 crash-loop. `reload` always does the full
  # bootout+bootstrap+kickstart (the only thing that re-reads the plist);
  # `status`/`heal` drive the self-heal watchdog.
  local sub="${1:-status}"; shift || true
  case "$sub" in
    reload) tartci_toml_exec "$HERE/scripts/tartci_launchd_watchdog.py" --reload "$@" ;;
    # PreToolUse classifier for agent shells: exit 2 blocks a raw launchctl
    # mutation of a lane (see scripts/launchctl_guard.py, `tartci hooks print`).
    guard) exec python3 "$HERE/scripts/launchctl_guard.py" "$@" ;;
    status) tartci_toml_exec "$HERE/scripts/tartci_launchd_watchdog.py" --status "$@" ;;
    heal)
      # Reboot/offline rejoin convergence includes the optional per-host relay
      # profile. Keep the watchdog's JSON output singular and pass dry-run
      # through without forwarding unrelated watchdog flags.
      local network_args=(reconcile --quiet)
      local arg
      local json_requested=0
      for arg in "$@"; do
        [ "$arg" = "--dry-run" ] && network_args+=(--dry-run)
        [ "$arg" = "--json" ] && json_requested=1
      done
      if [ "$json_requested" -eq 1 ]; then
        network_args=(reconcile --json)
        for arg in "$@"; do
          [ "$arg" = "--dry-run" ] && network_args+=(--dry-run)
        done
        local network_output
        if ! network_output="$(tartci_toml_python "$HERE/scripts/network_profile.py" "${network_args[@]}")"; then
          printf '%s\n' "$network_output"
          return 6
        fi
      else
        tartci_toml_python "$HERE/scripts/network_profile.py" "${network_args[@]}" || return 6
      fi
      tartci_toml_exec "$HERE/scripts/tartci_launchd_watchdog.py" "$@"
      ;;
    *) echo "usage: tartci launchd <reload <label> [--dry-run] [--allow-mid-job] | status | heal [--dry-run] [--json] | guard <--hook|--command CMD>>"; return 2 ;;
  esac
}

# Print (never write) the agent-harness hook settings that route every shell
# command through `tartci launchd guard`. Installing them is the operator's
# call: the snippet goes into ~/.claude/settings.json or a repo's
# .codex/hooks.json by hand.
cmd_hooks() {
  local sub="${1:-print}"
  case "$sub" in
    print)
      local shim="$HERE/hooks/claude-pretooluse-launchctl.sh"
      cat <<JSON
# Claude Code: merge into ~/.claude/settings.json (or .claude/settings.json)
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$shim", "timeout": 10 }
        ]
      }
    ]
  }
}

# Codex: merge into .codex/hooks.json (same PreToolUse contract: JSON on stdin,
# exit 2 blocks with stderr as the reason)
{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "$shim", "timeout": 10 }
        ]
      }
    ]
  }
}
JSON
      ;;
    *) echo "usage: tartci hooks print"; return 2 ;;
  esac
}

# A drain or an immediate stop removes this host from every label it serves.
# When no other host serves a required gate label, that takes the label to zero
# runners and stalls every pull request waiting on it, so the mutation is
# refused unless the caller names the consequence with --allow-last-serving-host.
# An indeterminate answer — an unreachable runner scope, an unresolvable host
# identity — refuses too: it cannot tell "another host is serving" apart from
# "nobody is".
tartci_pool_capacity_floor_preflight() {
  local action="$1" allow="$2" output rc=0
  local -a floor_args=(check --action "$action")
  [ "$allow" = 1 ] && floor_args+=(--allow-last-serving-host)
  output="$(tartci_toml_python "$HERE/scripts/capacity_floor.py" "${floor_args[@]}" 2>&1)" || rc=$?
  # The floor's own exit code (0 ok, 3 last serving host, 4 capacity unknown)
  # survives the collapse to 11 so callers can say which refusal it was.
  TARTCI_POOL_FLOOR_EXIT="$rc"
  case "$rc" in
    0)
      [ -n "$output" ] && printf '%s\n' "$output"
      return 0
      ;;
    127)
      echo "pool $action refused: the capacity floor needs Python 3.11+ with tomllib; set TARTCI_PYTHON" >&2
      return 11
      ;;
    *)
      printf '%s\n' "${output:-pool $action refused: the capacity floor failed without a typed cause}" >&2
      return 11
      ;;
  esac
}

# Print the installed-vs-declared verdicts (profile drift, published supply)
# before a transition. Reported, never enforced: refusing `pool on` over
# configuration drift would turn a config difference into a capacity outage,
# and the fix (reinstall or commit) is an operator decision, not a gate. Never
# fails; an unreadable verdict prints UNKNOWN.
tartci_pool_config_verdicts() {
  local config="$HOME/.config/tartci/macos-fleet-profile.toml" out
  [ -f "$config" ] || return 0
  out="$(tartci_toml_python "$HERE/scripts/macos_fleet_lanes.py" config-verdicts \
    --config "$config" --support-root "$HERE" \
    --receipt "$HOME/.config/tartci/macos-fleet-install.json" 2>&1)" \
    || out="profile drift: UNKNOWN (config check failed: ${out:-no output})
supply: UNKNOWN (config check failed)"
  printf '%s\n' "$out"
  # Only the drift and supply verdicts decide the disclaimer; the tartci
  # skew line that follows them is informational.
  case "$(printf '%s\n' "$out" | grep -E '^(profile drift|supply):' || true)" in
    *DRIFT*|*MISMATCH*|*UNKNOWN*)
      echo "(pool $1 does not refuse on this: drift is reported, not enforced, because refusing would turn a config difference into a capacity outage; see tartci fleet-macos verify-supply / profile-drift)" ;;
  esac
  return 0
}

# `tartci pool <on|off|drain> --plan`: the transition, printed, with nothing
# written — no participation/state record, no lock, no launchctl mutation.
# off/drain run every precondition the real transition runs and exit with its
# refusal code (11 capacity floor, 12 mid-job off), else 0. `on` checks only
# the installed receipt (7): its launch-helper probe, network-profile reconcile
# and loaded-generation verification act on the host, so they run only on the
# real `pool on`.
tartci_pool_plan() {
  local sub="$1" host="$2" agents_dir="$3" allow_last="$4" now="$5"
  local part state target_state target_part verdict=0 label loaded
  part="$(tartci_pool_read_participation)"
  state="$(tartci_pool_read_state)"
  case "$sub" in on) target_state=on target_part=1 ;; off) target_state=off target_part=0 ;;
    *) target_state=draining target_part=0 ;; esac
  echo "pool $sub --plan on $host: nothing will be changed"
  [ "$sub" = on ] && tartci_pool_config_verdicts on | sed 's/^/  /'
  echo "  state: $state -> $target_state; participation: $part -> $target_part"
  local agents action
  if [ "$sub" = on ]; then
    action="enable + bootstrap + kickstart"
    local fleet_receipt="$HOME/.config/tartci/macos-fleet-install.json"
    if tartci_pool_fleet_managed "$agents_dir" "$fleet_receipt"; then
      if ! agents="$(tartci_toml_python "$HERE/scripts/macos_fleet_lanes.py" verify-installed "$fleet_receipt" \
          --config "$HOME/.config/tartci/macos-fleet-profile.toml" \
          --agents-dir "$agents_dir" --support-root "$HERE" --print-services 2>&1)"; then
        echo "  REFUSE: installed macOS fleet profile has no valid receipt: $agents"
        return 7
      fi
    else
      agents="$(tartci_pool_runner_agents "$agents_dir")"
    fi
    echo "  not checked by --plan (they act on the host; the real pool on runs them):"
    echo "    launch-helper probe (exit 9), network-profile reconcile (6), loaded-generation verification (7)"
  else
    agents="$(tartci_pool_owned_runner_agents "$agents_dir")"
    if [ "$sub" = off ]; then action="disable + bootout"; else action="disable (restart only)"; fi
  fi
  echo "  owned runner agents ($action):"
  while IFS= read -r label; do
    [ -n "$label" ] || continue
    loaded=stopped
    tartci_pool_agent_loaded "$label" && loaded=running
    printf '    %-64s %s\n' "$label" "$loaded"
  done <<EOF
$agents
EOF
  [ -n "$agents" ] || echo "    (none)"
  [ "$sub" = on ] || tartci_pool_report_unowned "$sub" "$agents_dir" | sed 's/^/  /'
  if [ "$sub" != on ]; then
    local floor_output floor_rc=0
    TARTCI_POOL_FLOOR_EXIT=""
    # Not in a subshell: the preflight records the floor's exit code for the
    # verdict below. Output is captured through a temp file instead.
    local floor_tmp; floor_tmp="$(mktemp)"
    tartci_pool_capacity_floor_preflight "$sub" "$allow_last" >"$floor_tmp" 2>&1 || floor_rc=$?
    floor_output="$(cat "$floor_tmp")"; rm -f "$floor_tmp"
    if [ "$floor_rc" = 0 ]; then
      echo "  capacity floor: ok${floor_output:+ ($floor_output)}"
    else
      echo "  capacity floor: REFUSE (exit $floor_rc): $floor_output"
      verdict=11
    fi
    local mid_rows mid_rc=0 fate
    mid_rows="$(tartci_pool_mid_job "$agents_dir" 2>&1)" || mid_rc=$?
    if [ "$sub" = off ]; then fate="would be KILLED"; else fate="would finish its job"; fi
    echo "  mid-job lanes:"
    printf '%s\n' "$mid_rows" | awk -F '\t' -v fate="$fate" '
      $2 == "busy" { printf "    %s: busy, %s (%s)\n", $1, fate, $3; found=1; next }
      $2 == "unknown" { printf "    %s: UNKNOWN (%s)\n", $1, $3; found=1; next }
      NF < 2 && NF > 0 { print "    " $0; found=1 }
      END { if (!found) print "    (none)" }'
    if [ "$sub" = off ] && [ "$mid_rc" != 0 ]; then
      if [ "$now" = 1 ]; then
        echo "  --now given: pool off would stop those lanes immediately"
      else
        # The real `off` checks mid-job before the capacity floor.
        verdict=12
      fi
    fi
  fi
  case "$verdict" in
    0) echo "verdict: pool $sub would proceed" ;;
    11)
      # capacity_floor.py exits 3 last serving host, 4 capacity unknown, 2
      # usage; 127 is the no-tomllib interpreter probe. Only 3 and 4 are floor
      # verdicts; anything else means the floor never ran to a verdict.
      case "${TARTCI_POOL_FLOOR_EXIT:-}" in
        3) echo "verdict: pool $sub would REFUSE (last serving host for a required label; --allow-last-serving-host overrides)" ;;
        4) echo "verdict: pool $sub would REFUSE (capacity UNKNOWN: the runner census could not answer; --allow-last-serving-host does NOT override this — fix the census cause shown above, then re-run)" ;;
        *) echo "verdict: pool $sub would REFUSE (capacity floor could not run (exit ${TARTCI_POOL_FLOOR_EXIT:-unknown}): ${floor_output:-no output}; --allow-last-serving-host does NOT override this)" ;;
      esac
      ;;
    12) echo "verdict: pool off would REFUSE (an owned lane is mid-job or unknown; use pool drain, or --now)" ;;
  esac
  return "$verdict"
}

cmd_pool() {
  # host-level CI participation switch ("this machine, not now").
  # shellcheck source=providers/common/pool.lib.sh
  . "$HERE/providers/common/pool.lib.sh"
  local sub="${1:-status}"; shift || true
  local pool_usage="usage: tartci pool <on|drain|undrain|off|status|repair-lock> [--plan] [--now] [--json] [--require-ready] [--require-serving] [--allow-last-serving-host]
  --plan   on|off|drain: print what the transition would do and write nothing
           (off/drain: every precondition; on: the receipt check only)
  --now    off: stop immediately even though an owned lane is mid-job (kills it)
  exit 11 capacity floor refused; 12 off refused because a lane is mid-job"
  case "$sub" in
    -h|--help|help) echo "$pool_usage"; return 0 ;;
  esac
  local arg allow_last_serving_host=0 plan=0 now=0
  for arg in "$@"; do
    case "$arg" in
      -h|--help) echo "$pool_usage"; return 0 ;;
      --allow-last-serving-host) allow_last_serving_host=1 ;;
      --plan) plan=1 ;;
      --now) now=1 ;;
    esac
  done
  local host; host="$(scutil --get LocalHostName 2>/dev/null || hostname -s 2>/dev/null || echo host)"
  local agents_dir="$HOME/Library/LaunchAgents"
  if [ "$plan" = 1 ]; then
    case "$sub" in
      on|off|drain)
        tartci_pool_plan "$sub" "$host" "$agents_dir" "$allow_last_serving_host" "$now"
        return $?
        ;;
      *) echo "$pool_usage" >&2; return 2 ;;
    esac
  fi
  case "$sub" in
    on|off)
      local target=1
      [ "$sub" = off ] && target=0
      if [ "$sub" = off ]; then
        # `off` is the emergency stop and kills whatever an owned lane is
        # running. Refuse that unless the caller names it with --now, and do
        # it before participation is written, so a refusal changes nothing.
        if [ "$now" != 1 ]; then
          local mid_job_rows mid_job_rc=0
          mid_job_rows="$(tartci_pool_mid_job "$agents_dir" 2>&1)" || mid_job_rc=$?
          if [ "$mid_job_rc" != 0 ]; then
            {
              if [ "$mid_job_rc" = 1 ]; then
                echo "pool off refused: an owned lane is mid-job, and pool off would kill it:"
              else
                echo "pool off refused: could not prove every owned lane idle (busy state unknown):"
              fi
              printf '%s\n' "$mid_job_rows" | awk -F '\t' '$2 == "busy" || $2 == "unknown" { printf "  %s: %s (%s)\n", $1, $2, $3; next } NF < 2 && NF > 0 { print "  " $0 }'
              echo "Use \`tartci pool drain\` to let running jobs finish, \`tartci pool off --plan\`"
              echo "to see what off would stop, or \`tartci pool off --now\` to stop immediately anyway."
            } >&2
            return 12
          fi
        fi
        tartci_pool_capacity_floor_preflight off "$allow_last_serving_host" || return $?
        # Emergency stop deliberately bypasses the cooperative JIT-start lock.
        tartci_pool_write_participation 0
        tartci_pool_write_state off
      else
        tartci_pool_config_verdicts on
        tartci_pool_lock_acquire || { echo "pool transition busy" >&2; return 4; }
        local fleet_receipt="$HOME/.config/tartci/macos-fleet-install.json"
        local loaded_receipt="$HOME/.config/tartci/macos-fleet-loaded.json"
        local launch_helper_probe_receipt="$HOME/.config/tartci/macos-launch-helper-probe.json"
        local fleet_plists activation_agents=""
        fleet_plists="$(find "$agents_dir" -maxdepth 1 \
          -name 'com.danielraffel.tartci.tart-runner-macos-fleet.*.plist' \
          -print 2>/dev/null || true)"
        if [ -n "$fleet_plists" ] || [ -f "$fleet_receipt" ]; then
          if [ ! -f "$fleet_receipt" ]; then
            tartci_pool_lock_release
            echo "pool on refused: installed macOS fleet profile has no valid receipt" >&2
            return 7
          fi
          if activation_agents="$(tartci_toml_python "$HERE/scripts/macos_fleet_lanes.py" verify-installed "$fleet_receipt" \
              --config "$HOME/.config/tartci/macos-fleet-profile.toml" \
              --agents-dir "$agents_dir" --support-root "$HERE" \
              --print-services)"; then
            :
          else
            local fleet_verify_rc=$?
            tartci_pool_lock_release
            if [ "$fleet_verify_rc" = 127 ]; then
              echo "pool on refused: fleet readiness requires Python 3.11+ with tomllib; set TARTCI_PYTHON" >&2
            else
              echo "pool on refused: installed macOS fleet profile has no valid receipt" >&2
            fi
            return 7
          fi
        else
          activation_agents="$(tartci_pool_runner_agents "$agents_dir")"
        fi
        if [ -n "$fleet_plists" ]; then
          if tartci_toml_python "$HERE/scripts/macos_fleet_lanes.py" \
              probe-launch-helper "$fleet_receipt" \
              --config "$HOME/.config/tartci/macos-fleet-profile.toml" \
              --agents-dir "$agents_dir" --support-root "$HERE" \
              --output "$launch_helper_probe_receipt" >/dev/null; then
            :
          else
            local launch_helper_rc=$?
            rm -f "$launch_helper_probe_receipt"
            tartci_pool_lock_release
            if [ "$launch_helper_rc" = 127 ]; then
              echo "pool on refused: fleet readiness requires Python 3.11+ with tomllib; set TARTCI_PYTHON" >&2
            else
              echo "pool on refused: signed launch helper could not prove external-volume access" >&2
            fi
            return 9
          fi
        fi
        # A host-local network profile is an opt-in admission prerequisite.
        # Converge and prove its relay before making participation visible or
        # loading controllers; absent/disabled profiles are a strict no-op.
        local network_profile_output
        if ! network_profile_output="$(tartci_toml_python "$HERE/scripts/network_profile.py" reconcile --pool-lock-held 2>&1)"; then
          tartci_pool_lock_release
          printf 'pool on refused: %s\n' "${network_profile_output:-network-profile reconcile failed without a typed cause}" >&2
          return 6
        fi
        # A held-idle receipt authorizes exactly one drain era. Reopening the
        # pool invalidates it before any controller becomes eligible to admit.
        rm -f "$TARTCI_POOL_PERSISTENT_HOLD_FILE"
      fi
      local label n=0 launchd_target load_failed=0 activation_enabled disabled_line disabled_output
      local -a activation_attempted=()
      while IFS= read -r label; do
        [ -n "$label" ] || continue
        launchd_target="$(tartci_pool_launchd_target "$label")"
        if [ "$sub" = off ]; then
          launchctl disable "$launchd_target" >/dev/null 2>&1 || true
          if launchctl bootout "$launchd_target" >/dev/null 2>&1; then
            echo "  booted out $label"; n=$((n + 1))
          else
            echo "  (already stopped: $label)"
          fi
        else
          activation_attempted+=("$label")
          activation_enabled=1
          launchctl enable "$launchd_target" >/dev/null 2>&1 \
            || launchctl enable "$launchd_target" >/dev/null 2>&1 \
            || activation_enabled=0
          if [ "$activation_enabled" = 1 ] \
              && disabled_output="$(launchctl print-disabled "gui/$(id -u)" 2>&1)"; then
            disabled_line="$(
              printf '%s\n' "$disabled_output" \
                | grep -F "\"$label\" =>" \
                | head -1 \
                || true
            )"
            case "$disabled_line" in
              *"=> disabled"|*"=> true") activation_enabled=0 ;;
              ""|*"=> enabled"|*"=> false") ;;
              *) activation_enabled=0 ;;
            esac
          else
            activation_enabled=0
          fi
          if [ "$activation_enabled" = 1 ] \
            && { launchctl print "$launchd_target" >/dev/null 2>&1 \
            || { launchctl bootstrap "gui/$(id -u)" "$agents_dir/$label.plist" >/dev/null 2>&1 \
              && launchctl print "$launchd_target" >/dev/null 2>&1; }; }; then
            if launchctl kickstart "$launchd_target" >/dev/null 2>&1; then
              echo "  enabled $label"; n=$((n + 1))
            else
              echo "  (kickstart failed: $label)"
              load_failed=1
            fi
          else
            echo "  (enable skipped: $label)"
            load_failed=1
          fi
        fi
      done <<EOF
$([ "$sub" = on ] && printf '%s\n' "$activation_agents" || tartci_pool_owned_runner_agents "$agents_dir")
EOF
      if [ "$sub" = on ]; then
        if [ "$load_failed" = 0 ] && [ -n "$fleet_plists" ]; then
          tartci_toml_python "$HERE/scripts/macos_fleet_lanes.py" verify-loaded "$fleet_receipt" \
            --config "$HOME/.config/tartci/macos-fleet-profile.toml" \
            --agents-dir "$agents_dir" --support-root "$HERE" \
            --output "$loaded_receipt" >/dev/null || load_failed=1
        fi
        if [ "$load_failed" != 0 ]; then
          rm -f "$loaded_receipt"
          local rollback_failed=0
          _tartci_pool_rollback_service_absent() {
            local probe_output
            if probe_output="$(launchctl print "$1" 2>&1)"; then
              return 1
            fi
            case "$probe_output" in
              *"Could not find service"*|*"service not found"*) return 0 ;;
              *) return 1 ;;
            esac
          }
          # Any failed bootstrap, kickstart, or loaded-spec verification closes
          # admission, attempts to stop every receipted activation agent, and
          # proves the disabled/absent postcondition before claiming rollback.
          for label in "${activation_attempted[@]}"; do
            launchd_target="$(tartci_pool_launchd_target "$label")"
            launchctl disable "$launchd_target" >/dev/null 2>&1 \
              || launchctl disable "$launchd_target" >/dev/null 2>&1 \
              || rollback_failed=1
            if disabled_output="$(launchctl print-disabled "gui/$(id -u)" 2>&1)"; then
              disabled_line="$(
                printf '%s\n' "$disabled_output" \
                  | grep -F "\"$label\" =>" \
                  | head -1 \
                  || true
              )"
              case "$disabled_line" in
                *"=> disabled"|*"=> true") ;;
                *) rollback_failed=1 ;;
              esac
            else
              rollback_failed=1
            fi
            launchctl bootout "$launchd_target" >/dev/null 2>&1 || true
            if ! _tartci_pool_rollback_service_absent "$launchd_target"; then
              launchctl bootout "$launchd_target" >/dev/null 2>&1 || true
              _tartci_pool_rollback_service_absent "$launchd_target" \
                || rollback_failed=1
            fi
          done
          unset -f _tartci_pool_rollback_service_absent
          tartci_pool_write_participation 0
          tartci_pool_write_state off
          tartci_pool_lock_release
          if [ "$rollback_failed" != 0 ]; then
            echo "pool on failed and rollback could not prove every runner disabled and stopped" >&2
            return 10
          fi
          echo "pool on refused: loaded runner generation did not match its receipt" >&2
          return 7
        fi
        tartci_pool_write_state on
        tartci_pool_write_participation 1
        tartci_pool_lock_release
      fi
      echo "state: $sub; participation: $target"
      echo "runner agents changed: $n"
      if [ "$sub" = off ]; then
        tartci_pool_report_unowned off "$agents_dir"
        echo "opted OUT: $host agents unloaded immediately (pool off is not a drain)"
      else
        echo "opted IN: $host is participating in the CI pool"
      fi
      ;;
    repair-lock)
      local owner="" lock_identity="" owner_start="" boot_id=""
      [ "$(tartci_pool_read_participation)" = 0 ] \
        && [ "$(tartci_pool_read_state)" != on ] \
        || { echo "refusing lock repair while admission is open; run pool off first" >&2; return 5; }
      owner="$(cat "$TARTCI_POOL_TRANSITION_LOCK/pid" 2>/dev/null || true)"
      lock_identity="$(tartci_pool_lock_identity "$TARTCI_POOL_TRANSITION_LOCK" || true)"
      owner_start="$(ps -p "$owner" -o lstart= 2>/dev/null | sed 's/^ *//' || true)"
      boot_id="$(sysctl -n kern.boottime 2>/dev/null || awk '/btime/ {print $2; exit}' /proc/stat 2>/dev/null || true)"
      case "$owner" in
        ''|*[!0-9]*) echo "refusing lock repair: owner pid is missing or malformed" >&2; return 5 ;;
        *) kill -0 "$owner" 2>/dev/null \
          && { echo "refusing lock repair: owner pid $owner is alive" >&2; return 5; } ;;
      esac
      tartci_pool_zero_runner_workers \
        || { echo "refusing lock repair: Runner.Worker evidence is active or unavailable" >&2; return 5; }
      tartci_pool_zero_running_vms \
        || { echo "refusing lock repair: running Tart VM evidence is active or unavailable" >&2; return 5; }
      tartci_pool_lock_identity_matches "$TARTCI_POOL_TRANSITION_LOCK" "$lock_identity" "$owner" "$owner_start" "$boot_id" \
        || { echo "refusing lock repair: lock identity changed or could not be observed" >&2; return 5; }
      rm -f "$TARTCI_POOL_TRANSITION_LOCK/pid" 2>/dev/null || true
      rmdir "$TARTCI_POOL_TRANSITION_LOCK" 2>/dev/null || true
      [ ! -d "$TARTCI_POOL_TRANSITION_LOCK" ] \
        || { echo "lock repair failed: $TARTCI_POOL_TRANSITION_LOCK remains" >&2; return 5; }
      echo "repaired orphaned pool transition lock"
      ;;
    undrain)
      # The exact inverse of a drain that has not gone further: re-enable the
      # receipt-owned agents drain disabled (they stayed loaded) and reopen
      # admission. Unlike `pool on` it installs, loads and verifies nothing,
      # so it works on a host whose receipt `pool on` currently rejects (for
      # example after a macOS update) and returns it to exactly the service it
      # had before the drain. Refused unless the pool is draining.
      [ "$(tartci_pool_read_state)" = draining ] \
        || { echo "pool undrain refused: pool is $(tartci_pool_read_state), not draining" >&2; return 5; }
      tartci_pool_lock_acquire || { echo "pool transition busy" >&2; return 4; }
      local label launchd_target
      while IFS= read -r label; do
        [ -n "$label" ] || continue
        launchd_target="$(tartci_pool_launchd_target "$label")"
        launchctl enable "$launchd_target" >/dev/null 2>&1 || true
      done <<EOF
$(tartci_pool_owned_runner_agents "$agents_dir")
EOF
      tartci_pool_write_state on
      tartci_pool_write_participation 1
      tartci_pool_lock_release
      echo "undrained: $host admits work again (agents were never unloaded)"
      ;;
    drain)
      tartci_pool_capacity_floor_preflight drain "$allow_last_serving_host" || return $?
      # Close both native and provider admission before waiting for a provider
      # already inside the serialized JIT-start boundary.
      local prior_participation drain_wait_until
      prior_participation="$(tartci_pool_read_participation)"
      tartci_pool_write_participation 0
      # A supervisor minting a JIT runner holds the transition lock until its
      # listener starts, which can outlast one 10 s acquire. participation=0
      # already keeps any new mint out of that boundary, so the wait is bounded
      # by the one in flight. If it still never frees, put participation back:
      # a refused drain must leave the host exactly as it found it, never
      # "on" with admission closed (which no later `pool on` can repair while
      # a VM is running).
      drain_wait_until=$(( $(date +%s) + ${TARTCI_POOL_DRAIN_LOCK_WAIT_SECS:-180} ))
      until tartci_pool_lock_acquire; do
        if [ "$(date +%s)" -ge "$drain_wait_until" ]; then
          tartci_pool_write_participation "$prior_participation"
          echo "pool transition busy (drain refused; participation restored to $prior_participation)" >&2
          return 4
        fi
      done
      # Persist no-new-admission before touching any process. Native leases see
      # participation=0; cooperative providers observe pool-state=draining.
      tartci_pool_write_state draining
      # Scoped to receipt-owned agents: `launchctl disable` suppresses restart
      # until something enables the service again, and the only thing that does
      # is `pool on`, which activates the receipted set. Disabling an unowned
      # runner here retires it permanently and across reboots.
      local label launchd_target
      while IFS= read -r label; do
        [ -n "$label" ] || continue
        launchd_target="$(tartci_pool_launchd_target "$label")"
        launchctl disable "$launchd_target" >/dev/null 2>&1 || true
      done <<EOF
$(tartci_pool_owned_runner_agents "$agents_dir")
EOF
      tartci_pool_lock_release
      # Reported before the held-idle refusal below, so a drain that exits
      # pending still says which runners it left to their own authority.
      tartci_pool_report_unowned drain "$agents_dir"
      # Ephemeral providers finish their blocking run_one and then wait at the
      # admission gate. Only hosts with a persistent Actions service need the
      # detached receipt watcher; provider-only hosts terminalize immediately.
      local persistent_agents
      persistent_agents="$(tartci_pool_owned_runner_agents "$agents_dir" | grep '^actions[.]runner[.]' || true)"
      if [ -n "$persistent_agents" ]; then
        mkdir -p "$HOME/Library/Logs/tartci"
        nohup "$HERE/tartci" pool _drain-watch \
          >>"$HOME/Library/Logs/tartci/pool-drain.log" 2>&1 </dev/null &
      fi
      if [ -n "$persistent_agents" ] && ! tartci_pool_persistent_hold_ready; then
        echo "drain pending: persistent runners require an authoritative Shipyard held-idle receipt at $TARTCI_POOL_PERSISTENT_HOLD_FILE; no supported producer is currently shipped, so do not create this receipt manually" >&2
        return 3
      fi
      echo "draining: $host admits no new leases/jobs; assigned work may finish"
      ;;
    _drain-watch)
      while [ "$(tartci_pool_read_state)" = draining ]; do
        tartci_pool_quiesce_persistent_agents "$agents_dir" && exit 0
        sleep "${TARTCI_POOL_DRAIN_POLL_SECONDS:-2}"
      done
      ;;
    status)
      local status_json=0 require_ready=0 require_serving=0
      for arg in "$@"; do
        case "$arg" in
          --json) status_json=1 ;;
          --require-ready) require_ready=1 ;;
          --require-serving) require_serving=1 ;;
          *) echo "$pool_usage" >&2; return 2 ;;
        esac
      done
      local part; part="$(tartci_pool_read_participation)"
      local state; state="$(tartci_pool_read_state)"
      local lock_health_json
      lock_health_json="$(tartci_pool_lock_health_json)" \
        || lock_health_json='{"state":"unobservable","present":null}'
      local fleet_receipt="$HOME/.config/tartci/macos-fleet-install.json"
      local fleet_readiness='{"managed":false,"fleet_ready":null,"verified_running_supervisors":null,"expected_supervisors":null,"serving":{"blocked":null,"blocked_lanes":[],"unmeasurable_lanes":[]},"problems":[]}'
      local managed_plists=""
      managed_plists="$(find "$agents_dir" -maxdepth 1 -name 'com.danielraffel.tartci.tart-runner-macos-fleet.*.plist' -print -quit 2>/dev/null || true)"
      if [ -f "$fleet_receipt" ] || [ -n "$managed_plists" ]; then
        if fleet_readiness="$(tartci_toml_python "$HERE/scripts/macos_fleet_lanes.py" fleet-readiness "$fleet_receipt" \
          --config "$HOME/.config/tartci/macos-fleet-profile.toml" \
