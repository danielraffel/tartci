<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the per-host Shipyard ship-state reaper.

  Runs scripts/shipyard_queue_tick.sh periodically to reap orphaned ship-state
  records (merged/closed PRs, or PRs confirmed nonexistent), INDEPENDENT of any
  interactive session. It never merges, enqueues or arms a pull request:
  landing is the GitHub merge queue's job.

  Two modes, most-reversible first:
    1. DRY-RUN (APPLY=0) - logs what it would reap.
    2. REAP (APPLY=1)    - discards GitHub-confirmed MERGED/CLOSED records.
  Requires Shipyard 0.80.0 or newer. Install that release before this plist.

  Install shape (run on each CI host):

    scripts/install_shipyard_queue_tick.sh

  Run the installer help command for its wrapper, mode and install flags.

  The installer renders absolute paths, kickstarts the agent, and requires a
  fresh healthy verdict. Do not edit the installed plist by hand.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.shipyard.queue-tick</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.local/bin/tartci</string>
        <string>queue-tick</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$HOME</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/shipyard-queue-tick.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/shipyard-queue-tick.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TARTCI_LAUNCHD</key>
        <string>1</string>
        <key>HOME</key>
        <string>$HOME</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SHIPYARD_TICK_APPLY</key>
        <string>0</string>
        <key>SHIPYARD_QUEUE_REPO_ROOT</key>
        <string></string>
        <key>SHIPYARD_TICK_HEARTBEAT_FRESH_SECS</key>
        <string>300</string>
        <key>SHIPYARD_QUEUE_SELF_REPAIR</key>
        <string>1</string>
        <key>SHIPYARD_QUEUE_CANONICAL_CONFIG</key>
        <string>$HOME/.config/shipyard/queue-tick.env</string>
    </dict>
</dict>
</plist>
