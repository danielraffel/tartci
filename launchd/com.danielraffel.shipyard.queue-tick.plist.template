<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the per-host Shipyard queue janitor.

  Runs scripts/shipyard_queue_service_tick.sh periodically. The supervisor
  starts legacy ship-state cleanup and deterministic Pulp/Forge/Vellum runner
  stewardship concurrently, with separate health/reporting. Neither lane can
  prevent the other from running. No model is involved.

  SAFETY: three-stage rollout, most-reversible first.
    1. DRY-RUN (APPLY=0)                — logs only; observe the log.
    2. REAP-ONLY (APPLY=1, REAP_ONLY=1) — acts on the proven path (discard
       GitHub-confirmed MERGED/CLOSED orphans) but HOLDS the auto-merge action
       in surface-only mode. Enable this once dry-run has baked.
    3. FULL-LIVE (APPLY=1, QUEUE_AUTHORITY=1) — the supervisor keeps legacy
       ship-state work reap-only and enables deterministic cross-repository
       `shipyard runner steward`. Enable on exactly one fleet host.
  Neither lane reimplements merge logic. The steward delegates exact-head queue
  policy to Shipyard; cleanup discards only GitHub-confirmed MERGED/CLOSED
  records. Requires Shipyard 0.97.1 or newer.

  Install shape (run on each CI host — m1/m3/m5):

    scripts/install_shipyard_queue_tick.sh

  Run the installer help command for its repo-root, authority, mode, and apply
  flags.

  The installer renders absolute paths, kickstarts the agent, and requires a
  fresh healthy verdict. After observing the dry-run log, arm exactly one
  authority in live mode with an explicit GitHub App wrapper. Use reap-only
  mode for a non-authority host that should clean terminal ship-state. Do not
  edit the installed plist by hand.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.shipyard.queue-tick</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.local/share/tartci/scripts/shipyard_queue_service_tick.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$HOME</string>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/shipyard-queue-tick.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/shipyard-queue-tick.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>$HOME</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SHIPYARD_TICK_APPLY</key>
        <string>0</string>
        <key>SHIPYARD_QUEUE_AUTHORITY</key>
        <string></string>
        <key>SHIPYARD_QUEUE_REPO_ROOT</key>
        <string></string>
        <key>SHIPYARD_TICK_REAP_ONLY</key>
        <string>0</string>
        <key>SHIPYARD_TICK_HEARTBEAT_FRESH_SECS</key>
        <string>300</string>
        <key>SHIPYARD_TICK_MERGE_METHOD</key>
        <string>merge</string>
        <key>SHIPYARD_QUEUE_SELF_REPAIR</key>
        <string>1</string>
        <key>SHIPYARD_QUEUE_CANONICAL_CONFIG</key>
        <string>$HOME/.config/shipyard/queue-tick.env</string>
    </dict>
</dict>
</plist>
