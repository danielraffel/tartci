<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for an Orchard worker (SHADOW mode) on a pool host.

  Registers this host as an Orchard worker that advertises DERATED capacity
  (the host's vm_pool_cores from `tartci host-profile`, NOT physical) and
  `org.cirruslabs.tart-vms=0`, then is PAUSED immediately so the controller
  schedules nothing onto it. This is the safe shadow shape: registered +
  observable, never placed.

  Prereq: `brew install cirruslabs/cli/orchard`, controller running on m3, and a
  worker bootstrap token from a `compute:read,compute:write` service account.

  Per-host values (fill before install):
    HOST   = m3 | m5 | m1
    ROLE   = dedicated-builder | dev-overflow | light
    CORES  = vm_pool_cores from `tartci host-profile` (m3=14, m5=6, m1=3)
    MEMMIB = a conservative memory advert (e.g. CORES * 3.5 GiB)

  Install shape (per host):
    ORCH=$HOME/Library/LaunchAgents/com.danielraffel.tartci.orchard-worker.plist
    sed -e "s|\$HOME|$HOME|g" -e "s|@HOST@|$HOST|g" -e "s|@ROLE@|$ROLE|g" \
        -e "s|@CORES@|$CORES|g" -e "s|@MEMMIB@|$MEMMIB|g" \
      launchd/com.danielraffel.tartci.orchard-worker.plist.template > "$ORCH"
    # put the bootstrap token in $HOME/.orchard-shadow/worker-token (chmod 600)
    launchctl bootstrap "gui/$(id -u)" "$ORCH"
    orchard pause worker "$HOST"     # <-- REQUIRED in shadow mode

  Verify: `tartci status --json` shows the worker present + paused, zero VMs.
  Uninstall: launchctl bootout "gui/$(id -u)/com.danielraffel.tartci.orchard-worker"
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.tartci.orchard-worker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec /opt/homebrew/bin/orchard worker run --name @HOST@ --labels host=@HOST@,role=@ROLE@,tier=shadow --resources org.cirruslabs.logical-cores=@CORES@,org.cirruslabs.memory-mib=@MEMMIB@,org.cirruslabs.tart-vms=0 --default-cpu 1 --default-memory 1024 --bootstrap-token-stdin $HOME/.orchard-shadow/controller-url &lt; $HOME/.orchard-shadow/worker-token</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>ORCHARD_HOME</key>
        <string>$HOME/.orchard-shadow</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/tartci/orchard-worker.out.log</string>
    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/tartci/orchard-worker.err.log</string>
</dict>
</plist>
