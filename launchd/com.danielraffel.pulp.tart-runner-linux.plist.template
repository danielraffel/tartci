<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the Tart ephemeral GitHub Actions runner supervisor on
  LINUX (providers/tart-linux/runner.sh). One throwaway clone of the Linux golden
  per job, then discarded. The pool-serving sibling of `tartci up linux`.

  This is the lane the Shipyard macOS GUI's "Serve CI builds from this Mac"
  switch toggles via launchctl load/unload. The GUI hard-codes the agent LABEL
  below (com.danielraffel.pulp.tart-runner-linux), so KEEP that label as-is when
  serving Pulp. A different consuming repo renames BOTH this label and the
  matching row in shipyard-macos-gui's CIServingLane.known.

  Install (per Apple Silicon host that serves the Linux Tart golden):

    1. Bake the golden: it must carry the actions-runner agent at ~/actions-runner
       (actions-runner-linux-arm64). Copy the Linux golden into this host's TART_HOME.
    2. Install tartci with `./tartci setup` from a checkout. It installs the
       ~/.local/bin/tartci shim onto the installed generation, which self-update
       keeps current. Never hand-copy a tartci checkout under ~/.local/share:
       nothing refreshes it, and agents running from it go stale.

    3. Copy this file to ~/Library/LaunchAgents/, replacing $HOME, this host's label and
       $TART_HOME with absolute paths — launchd does NOT expand shell variables:

         sed -e "s|\$HOME|$HOME|g" \
             -e "s|\$TARTCI_HOST_LABEL|pulp-host-<this host>|g" \
             -e "s|\$TART_HOME|$HOME/VMs|g" \
           launchd/com.danielraffel.pulp.tart-runner-linux.plist.template \
           > ~/Library/LaunchAgents/com.danielraffel.pulp.tart-runner-linux.plist

       Never re-run this render over an installed plist: it resets every
       host value to this template's default. That includes the host label,
       the golden store, TARTCI_VM_POLL and the ghapp-shim PATH entry. A
       render of the stock template on m1 would have produced a lane labelled
       pulp-host-macstudio with the wrong golden store (2026-10-03). To move an installed
       plist forward, change only the keys that changed and keep the rest.

       Set TART_HOME to the absolute path where this host's Tart goldens live.
    4. Grant Full Disk Access if TART_HOME is on /Volumes (TCC; exit 126 without).
    5. Load:   launchctl load ~/Library/LaunchAgents/com.danielraffel.pulp.tart-runner-linux.plist
       Verify: launchctl list | grep tart-runner-linux ; tail -F ~/Library/Logs/tartci/tart-runner-linux.log
    Stop:      launchctl unload ~/Library/LaunchAgents/com.danielraffel.pulp.tart-runner-linux.plist
               (or flip the Linux toggle off in the Shipyard macOS GUI)

  PILOT vs GRADUATE: the default labels routed below include the non-required
  shared pool label `pulp-build-linux` and a host-specific label. Use
  `pulp-host-macstudio` on the primary Mac Studio and `pulp-host-m5` on the
  overflow M5/laptop. The workflow resolver should choose the Mac Studio
  selector first, the M5 selector second, and GitHub-hosted when each local
  selector is already at its configured in-progress capacity; queued Actions jobs
  cannot change `runs-on` after dispatch.
  Linux guests are uncapped, so concurrency is not bounded by the macOS 2-VM
  kernel quota.

  Requires on this host: tart + the Linux golden in TART_HOME, gh authenticated
  for the target repo (repo admin, to mint JIT configs), and ~/.ssh/id_ed25519
  accepted by the golden. Override repo/golden/labels via the runner.sh env vars
  (TARTCI_RUNNER_REPO / TARTCI_LINUX_GOLDEN / TARTCI_RUNNER_LABELS).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.pulp.tart-runner-linux</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.local/bin/tartci</string>
        <string>serve</string>
        <string>linux</string>
        <string>--loop</string>
        <string>--labels</string>
        <string>self-hosted,Linux,ARM64,pulp-build-linux,$TARTCI_HOST_LABEL</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$HOME</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/tartci/tart-runner-linux.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/tartci/tart-runner-linux.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TARTCI_LAUNCHD</key>
        <string>1</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TARTCI_GH_CLI</key>
        <string>ghapp</string>
        <key>TARTCI_ADMISSION_CLEAN_MODE</key>
        <string>disabled</string>
        <key>TART_HOME</key>
        <string>$TART_HOME</string>
        <key>TARTCI_VM_POLL</key>
        <string>10</string>
        <key>TARTCI_RUNNER_IDLE_TIMEOUT_SECS</key>
        <string>300</string>
        <key>TARTCI_RUNNER_MAX_QUEUED_AGE_SECONDS</key>
        <string>21600</string>
        <key>TARTCI_LINUX_BUILD_PARALLEL_LEVEL</key>
        <string>4</string>
        <key>TARTCI_LINUX_LOGS</key>
        <string>$HOME/VMs/logs/tartci-linux</string>
    </dict>
</dict>
</plist>
