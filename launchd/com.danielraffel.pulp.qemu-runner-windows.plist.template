<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the QEMU ephemeral GitHub Actions runner supervisor on
  WINDOWS (providers/qemu-windows/runner.sh). One CoW overlay off the Windows
  golden qcow2 per job, on a dynamic SSH port, then discarded. The pool-serving
  sibling of `tartci up windows`.

  This is the lane the Shipyard macOS GUI's "Serve CI builds from this Mac"
  switch toggles via launchctl load/unload. The GUI hard-codes the agent LABEL
  below (com.danielraffel.pulp.qemu-runner-windows), so KEEP that label as-is when
  serving Pulp. A different consuming repo renames BOTH this label and the
  matching row in shipyard-macos-gui's CIServingLane.known.

  Install (per Apple Silicon host that serves the Windows golden):

    1. Copy the Windows golden qcow2 into this host's $TARTCI_GOLDENS
       (default $HOME/.tartci/goldens). The supervisor install-if-missing the
       win-arm64 runner agent into the clone, so the golden need not pre-bake it.
    2. Copy this file to ~/Library/LaunchAgents/, replacing $TARTCI_REPO, $HOME, and
       $TARTCI_GOLDENS with absolute paths (launchd does NOT expand shell vars):

         sed -e "s|\$TARTCI_REPO|$PWD|g" -e "s|\$HOME|$HOME|g" \
             -e "s|\$TARTCI_GOLDENS|$HOME/.tartci/goldens|g" \
           launchd/com.danielraffel.pulp.qemu-runner-windows.plist.template \
           > ~/Library/LaunchAgents/com.danielraffel.pulp.qemu-runner-windows.plist

    3. Load:   launchctl load ~/Library/LaunchAgents/com.danielraffel.pulp.qemu-runner-windows.plist
       Verify: launchctl list | grep qemu-runner-windows ; tail -F ~/Library/Logs/tartci/qemu-runner-windows.log
    Stop:      launchctl unload ~/Library/LaunchAgents/com.danielraffel.pulp.qemu-runner-windows.plist
               (or flip the Windows toggle off in the Shipyard macOS GUI)

  PILOT: the default label is the non-required `pulp-build-windows`. Windows VMs
  are QEMU (not Tart) and uncapped; each job gets a throwaway qcow2 overlay.

  Requires on this host: qemu (brew install qemu) + the Windows golden qcow2,
  gh authenticated for the target repo (repo admin, to mint JIT configs), and
  ~/.ssh/id_ed25519 accepted by the golden. Override repo/golden/labels via the
  runner.sh env vars (TARTCI_RUNNER_REPO / TARTCI_WIN_GOLDEN / TARTCI_RUNNER_LABELS).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.pulp.qemu-runner-windows</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$TARTCI_REPO/providers/qemu-windows/runner.sh</string>
        <string>--loop</string>
        <string>--labels</string>
        <string>self-hosted,Windows,ARM64,pulp-build-windows</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$TARTCI_REPO</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/tartci/qemu-runner-windows.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/tartci/qemu-runner-windows.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin</string>
        <key>TARTCI_GOLDENS</key>
        <string>$TARTCI_GOLDENS</string>
    </dict>
</dict>
</plist>
