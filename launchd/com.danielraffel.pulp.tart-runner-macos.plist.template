<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the Tart ephemeral GitHub Actions runner supervisor on
  macOS. One throwaway clone of the macOS golden per job, then discarded. The
  pool-serving sibling of `tartci up macos`.

  IMPORTANT: the Mac Studio proof on 2026-06-09 showed that launchd cannot
  execute the Pulp runner from /Volumes/Workshop/Code/pulp:

    shell-init: getcwd: Operation not permitted
    /bin/bash: /Volumes/Workshop/Code/pulp/tools/ci/tart-runner.sh: Operation not permitted

  Keep this plist anchored under $HOME:
  - ProgramArguments points at $HOME/.local/bin/tartci, not a /Volumes checkout.
  - WorkingDirectory is $HOME.
  - TART_HOME is $HOME/VMs.

  Install shape (per Mac that hosts the macOS Tart golden):

    1. Install tartci under $HOME so BASH_SOURCE resolves inside a readable tree:

         mkdir -p "$HOME/.local/share/tartci" "$HOME/.local/bin" "$HOME/VMs" "$HOME/Library/Logs/tartci"
         rsync -a "$PWD/" "$HOME/.local/share/tartci/"
         printf '%s\n' '#!/usr/bin/env bash' \
           'exec /bin/bash "$HOME/.local/share/tartci/tartci" "$@"' \
           > "$HOME/.local/bin/tartci"
         chmod 755 "$HOME/.local/bin/tartci"

    2. Put macOS goldens under $HOME/VMs. Avoid /Volumes unless using a signed
       FDA helper; ordinary LaunchAgents hit TCC there.

    3. Render this template with absolute paths:

         sed -e "s|\$HOME|$HOME|g" \
           launchd/com.danielraffel.pulp.tart-runner-macos.plist.template \
           > "$HOME/Library/LaunchAgents/com.danielraffel.pulp.tart-runner-macos-gate.plist"

    4. Load:

         scripts/migrate_macos_gate_agent.sh --apply --attest-external-gui-label-updated

       Verify:

         launchctl print "gui/$(id -u)/com.danielraffel.pulp.tart-runner-macos-gate"
         tail -F "$HOME/Library/Logs/tartci/tart-runner-macos.log"

       Stop:

         launchctl bootout "gui/$(id -u)/com.danielraffel.pulp.tart-runner-macos-gate"

  PILOT vs GRADUATE: default labels below target the non-required
  `pulp-build-vm` pilot lane. After the pilot is green, production Pulp-style
  required macOS routing uses BOTH labels:

    self-hosted,macOS,ARM64,pulp-build,pulp-build-vm

  Then route the workflow selector to that full set, for example:

    PULP_LOCAL_MACOS_RUNS_ON_JSON=["self-hosted","macOS","ARM64","pulp-build","pulp-build-vm"]
    PULP_LOCAL_MAC_RUNNER_LABEL=pulp-build-vm

  Keep bare-metal `pulp-build` runners online as rollback fallback. They remain
  excluded from the default VM route because they do not advertise
  `pulp-build-vm`.

  MIGRATION: never run the legacy `com.danielraffel.pulp.tart-runner` label
  side-by-side with this agent. The migration helper bootouts and removes that
  exact legacy plist before loading this replacement. A pre-start identity guard
  independently refuses duplicate loaded labels resolving to one runner/state.

  Requires on this host: tart + the macOS golden in TART_HOME, gh authenticated
  for the target repo (repo admin, to mint JIT configs), and ~/.ssh/id_ed25519
  accepted by the golden. Override repo/golden/labels via tartci runner env vars.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.pulp.tart-runner-macos-gate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.local/bin/tartci</string>
        <string>serve</string>
        <string>macos</string>
        <string>--loop</string>
        <string>--labels</string>
        <string>self-hosted,macOS,ARM64,pulp-build-vm</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$HOME</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/tartci/tart-runner-macos.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/tartci/tart-runner-macos.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>$HOME</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TARTCI_GH_CLI</key>
        <string>ghapp</string>
        <key>TARTCI_LAUNCHD_LABEL</key>
        <string>com.danielraffel.pulp.tart-runner-macos-gate</string>
        <key>TART_HOME</key>
        <string>$HOME/VMs</string>
        <key>TARTCI_HOME</key>
        <string>$HOME/.tartci</string>
        <key>TARTCI_CI_CACHE</key>
        <string>$HOME/.cache/pulp-ci</string>
        <key>TARTCI_RUNNER_REPO</key>
        <string>Generous-Corp/pulp</string>
        <key>TARTCI_MACOS_GOLDEN</key>
        <string>pulp-build-runner:latest</string>
        <key>TARTCI_RUNNER_LABELS</key>
        <string>self-hosted,macOS,ARM64,pulp-build-vm</string>
        <key>TARTCI_RUNNER_WORKFLOW_NAME</key>
        <string>Build and Test</string>
    </dict>
</dict>
</plist>
