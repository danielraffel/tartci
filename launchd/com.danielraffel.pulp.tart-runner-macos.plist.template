<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd template for the Tart ephemeral GitHub Actions runner supervisor on
  macOS. One throwaway clone of the macOS golden per job, then discarded. The
  pool-serving sibling of `tartci up macos`.

  IMPORTANT: the Mac Studio proof on 2026-06-09 showed that launchd cannot
  execute the Pulp runner from /Volumes/Workshop/Code/pulp:

    shell-init: getcwd: Operation not permitted
    /bin/bash: /Volumes/Workshop/Code/pulp/tools/ci/tart-runner.sh: Operation not permitted

  Keep this plist anchored under $HOME:
  - ProgramArguments points at $HOME/.local/bin/tartci, not a /Volumes checkout.
  - WorkingDirectory is $HOME.
  - TART_HOME is rendered from this host's declared VM store. Most hosts use
    $HOME/VMs; hosts with a dedicated external CI volume may intentionally use
    that volume instead.

  Install shape (per Mac that hosts the macOS Tart golden):

    1. Install tartci under $HOME so BASH_SOURCE resolves inside a readable tree:

         mkdir -p "$HOME/.local/share/tartci" "$HOME/.local/bin" "$HOME/Library/Logs/tartci"
         rsync -a "$PWD/" "$HOME/.local/share/tartci/"
         printf '%s\n' '#!/usr/bin/env bash' \
           'exec /bin/bash "$HOME/.local/share/tartci/tartci" "$@"' \
           > "$HOME/.local/bin/tartci"
         chmod 755 "$HOME/.local/bin/tartci"

    2. Declare this host's store explicitly and create it. A store on /Volumes
       requires Full Disk Access for the executable launchd spawns:

         export TART_HOME="$HOME/VMs" # or this host's external CI volume
         mkdir -p "$TART_HOME"

    3. Render this template with absolute paths:

         : "${TART_HOME:?declare this host's Tart VM store}"
         python3 scripts/render_launchd_template.py \
           launchd/com.danielraffel.pulp.tart-runner-macos.plist.template \
           --set "TART_HOME=$TART_HOME" --set "HOME=$HOME" \
           > "$HOME/Library/LaunchAgents/com.danielraffel.pulp.tart-runner-macos-gate.plist"

    4. Load:

         scripts/migrate_macos_gate_agent.sh --apply --attest-external-gui-label-updated

       Verify:

         launchctl print "gui/$(id -u)/com.danielraffel.pulp.tart-runner-macos-gate"
         tail -F "$HOME/Library/Logs/tartci/tart-runner-macos.log"

       Stop:

         launchctl bootout "gui/$(id -u)/com.danielraffel.pulp.tart-runner-macos-gate"

  The default labels below are the production fast-gate base. Event-class
  labels are added by TARTCI_RUNNER_WORKFLOW_TIERS at registration time:

    merge_group -> pulp-build-merge-group
    pull_request -> pulp-build-pr-head

  The shipped mode is `legacy`, so deploying these bytes does not add API work
  or change assignment. Set `observe` on one drained host to keep generic-label
  assignment while emitting a bounded parity sample every 15 minutes. Promote
  one drained host at a time to `event-class-v2`. In V2, `pulp-gate-fast` is
  removed from the advertised base and exactly one event-class label is added;
  an older generic-only job therefore cannot claim the JIT runner. Roll back by
  restoring `observe` before removing event labels from queued workflow jobs.

  The configured selector remains the reviewed generic base, for example:

    PULP_LOCAL_MACOS_RUNS_ON_JSON=["self-hosted","macOS","ARM64","pulp-build","pulp-build-vm","pulp-gate-fast"]
    PULP_LOCAL_MAC_RUNNER_LABEL=pulp-gate-fast

  Keep bare-metal `pulp-build` runners online as rollback fallback. They remain
  excluded from the default VM route because they do not advertise
  `pulp-build-vm`.

  MIGRATION: never run the legacy `com.danielraffel.pulp.tart-runner` label
  side-by-side with this agent. The migration helper bootouts and removes that
  exact legacy plist before loading this replacement. A pre-start identity guard
  independently refuses duplicate loaded labels resolving to one runner/state.

  Requires on this host: tart + the macOS golden in TART_HOME, gh authenticated
  for the target repo (repo admin, to mint JIT configs), and ~/.ssh/id_ed25519
  accepted by the golden. Override repo/golden/labels via tartci runner env vars.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.danielraffel.pulp.tart-runner-macos-gate</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$HOME/.local/bin/tartci</string>
        <string>serve</string>
        <string>macos</string>
        <string>--loop</string>
        <string>--labels</string>
        <string>self-hosted,macOS,ARM64,pulp-build,pulp-build-vm,pulp-gate-fast</string>
    </array>

    <key>WorkingDirectory</key>
    <string>$HOME</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>$HOME/Library/Logs/tartci/tart-runner-macos.log</string>

    <key>StandardErrorPath</key>
    <string>$HOME/Library/Logs/tartci/tart-runner-macos.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>$HOME</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>TARTCI_GH_CLI</key>
        <string>ghapp</string>
        <key>TARTCI_ADMISSION_CLEAN_MODE</key>
        <string>disabled</string>
        <key>TARTCI_LAUNCHD_LABEL</key>
        <string>com.danielraffel.pulp.tart-runner-macos-gate</string>
        <key>TART_HOME</key>
        <string>$TART_HOME</string>
        <key>TARTCI_HOME</key>
        <string>$HOME/.tartci</string>
        <key>TARTCI_CI_CACHE</key>
        <string>$HOME/.cache/pulp-ci</string>
        <key>TARTCI_RUNNER_REPO</key>
        <string>Generous-Corp/pulp</string>
        <key>TARTCI_MACOS_GOLDEN</key>
        <string>pulp-build-runner:latest</string>
        <key>TARTCI_RUNNER_LABELS</key>
        <string>self-hosted,macOS,ARM64,pulp-build,pulp-build-vm,pulp-gate-fast</string>
        <key>TARTCI_RUNNER_WORKFLOW_TIERS</key>
        <string>pulp-build-merge-group|Build and Test
pulp-build-pr-head|Build and Test</string>
        <key>TARTCI_RUNNER_ASSIGNMENT_MODE</key>
        <string>legacy</string>
        <key>TARTCI_ASSIGNMENT_V2_OMIT_LABELS</key>
        <string>pulp-gate-fast</string>
        <key>TARTCI_ASSIGNMENT_V2_REQUIRED_OMIT_LABELS</key>
        <string>pulp-gate-fast</string>
        <key>TARTCI_ASSIGNMENT_V2_CLASS_LABELS</key>
        <string>pulp-build-merge-group,pulp-build-pr-head</string>
    </dict>
</dict>
</plist>
